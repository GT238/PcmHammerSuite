<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Windows only. Without the supported-OS list, controls that embed a native window (the Help and
       Credits pages in the Flash screen use a web view) cannot create their child window and crash the app.
       Same as the manifest in PcmHammer's own desktop heads. -->
  <assemblyIdentity version="1.0.0.0" name="PcmSuite"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>

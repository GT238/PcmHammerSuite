<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PcmSuite.MainWindow"
        Icon="avares://PcmSuite/Assets/PcmSuite.ico"
        Title="PCM Suite (prototype)" Width="1920" Height="1080" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Shell status: says what the hand-off between tabs did. -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <TextBlock x:Name="ShellStatus" Text="Pick a tab. Only one tab holds the adapter at a time."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Border>

        <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="avares://PcmSuite/Assets/Tabs/Flash.png" Width="28" Height="28"/>
                        <TextBlock Text="Flash" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="FlashHost"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="avares://PcmSuite/Assets/Tabs/Logger.png" Width="28" Height="28"/>
                        <TextBlock Text="Logger" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="LoggerHost"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="avares://PcmSuite/Assets/Tabs/Tune.png" Width="28" Height="28"/>
                        <TextBlock Text="Tuner" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="TuneHost"/>
            </TabItem>
            <TabItem Header="Logs"><ContentControl x:Name="LogsHost"/></TabItem>
            <TabItem Header="Help"><ContentControl x:Name="HelpHost"/></TabItem>
            <TabItem Header="Credits"><ContentControl x:Name="CreditsHost"/></TabItem>
            <TabItem Header="About"><ContentControl x:Name="AboutHost"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="using:FluentAvalonia.Styling"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             x:Class="PcmSuite.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <styling:FluentAvaloniaTheme />

        <!-- The copy-to-clipboard button on the flasher's Results and Debug tabs (the same style PCM Hammer's own App defines). -->
        <Style Selector="Button.CopyButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip.Tip" Value="Copy to Clipboard"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <Panel>
                            <ic:FluentIcon Name="PART_CopyIcon" Icon="Copy" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ic:FluentIcon Name="PART_CheckIcon" Icon="Checkmark" FontSize="14" Opacity="0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CopyButtonStyle:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="Button.CopyButtonStyle:pointerover /template/ ic|FluentIcon#PART_CopyIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <Style Selector="Button.CopyButtonStyle:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
        </Style>
        <Style Selector="Button.CopyButtonStyle.copied">
            <Setter Property="ToolTip.Tip" Value="Copied!"/>
        </Style>
        <Style Selector="Button.CopyButtonStyle.copied /template/ ic|FluentIcon#PART_CopyIcon">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Button.CopyButtonStyle.copied /template/ ic|FluentIcon#PART_CheckIcon">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Application.Styles>
</Application>

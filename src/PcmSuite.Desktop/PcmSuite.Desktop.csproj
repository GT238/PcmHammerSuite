<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PcmSuite</RootNamespace>
    <AssemblyName>PcmSuite</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\PcmSuite.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- For the self-contained Windows download: dotnet publish -p:SelfContainedWin=true. The runtime is chosen here, in the project, and not with
       -r on the command line, because -r would also be applied to PCM Hammer's projects that target Android, and that fails. -->
  <PropertyGroup Condition="'$(SelfContainedWin)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Window and taskbar icon (the same artwork as the exe icon). -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\PcmSuite.ico" Link="Assets\PcmSuite.ico" />
  </ItemGroup>

  <!-- Tab icons: the Flasher and Logger pictures come straight from the PCM Hammer submodule; the Tuner's is ours. -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\extern\PcmHammer\Apps\UI\Avalonia\PCMHammerAvalonia\Assets\Icon.png" Link="Assets\Tabs\Flash.png" />
    <AvaloniaResource Include="..\..\extern\PcmHammer\Apps\UI\Avalonia\PCMLoggerAvalonia.Android\Icon.png" Link="Assets\Tabs\Logger.png" />
    <AvaloniaResource Include="..\..\assets\PcmTuner.png" Link="Assets\Tabs\Tune.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="FluentAvaloniaUI" />
  </ItemGroup>

  <!-- PcmHammer's own Avalonia libraries, reused unchanged from the submodule. -->
  <ItemGroup>
    <ProjectReference Include="..\..\extern\PcmHammer\Apps\UI\Avalonia\PCMHammerAvalonia\PCMHammerAvalonia.csproj" />
    <ProjectReference Include="..\..\extern\PcmHammer\Apps\UI\Avalonia\PCMLoggerAvalonia\PCMLoggerAvalonia.csproj" />
  </ItemGroup>

  <!-- Credits tab: PcmSuite's own page, plus PCM Hammer's credits page taken straight from the submodule
       (Apps/UI/Shared/credits.html is the up-to-date copy shared by its other front ends). -->
  <ItemGroup>
    <Content Include="Credits\PcmSuite-credits.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\extern\PcmHammer\Apps\UI\Shared\credits.html" Link="Credits\PcmHammer-credits.html"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Help tab: PcmSuite's own pages, plus PCM Hammer's help page taken straight from the submodule. -->
  <ItemGroup>
    <Content Include="Help\*.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\extern\PcmHammer\Apps\UI\Shared\help.html" Link="Help\PcmHammer-help.html"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Logging profiles for tuning tasks (PCM Hammer's .LogProfile format), offered from the Tune tab. -->
  <ItemGroup>
    <Content Include="Profiles\*.LogProfile" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tuning code ported from LS-Studio. -->
  <ItemGroup>
    <ProjectReference Include="..\PcmSuite.Tuning.Core\PcmSuite.Tuning.Core.csproj" />
    <ProjectReference Include="..\PcmSuite.Tuning\PcmSuite.Tuning.csproj" />
    <ProjectReference Include="..\PcmSuite.Tuning.Views\PcmSuite.Tuning.Views.csproj" />
  </ItemGroup>

  <!-- Version and git commits stamped into the build (shown on the About tab and in crash logs). -->
  <Import Project="..\..\build\BuildInfo.targets" />
</Project>

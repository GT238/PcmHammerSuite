<?xml version="1.0" encoding="utf-8"?>
<LogProfile>
    <!-- For checking the MAF calibration: measured airflow, the load calculated from it, and the trims that show whether the airflow reading is right. A trim that stays high or low across a range points at the MAF table. -->
    <PidParameters>
        <PidParameter id="EngineSpeed" units="RPM" zoom="False" />
        <PidParameter id="MAPSensor" units="kPa" zoom="False" />
        <PidParameter id="MAFSensor" units="g/s" zoom="False" />
        <PidParameter id="ThrottlePosition" units="%" zoom="False" />
        <PidParameter id="IATSensor" units="°F" zoom="False" />
        <PidParameter id="ShortTermFTLeftBank" units="%" zoom="False" />
        <PidParameter id="LongTermFTLeftBank" units="%" zoom="False" />
        <PidParameter id="ShortTermFTRightBank" units="%" zoom="False" />
        <PidParameter id="LongTermFTRightBank" units="%" zoom="False" />
    </PidParameters>
    <RamParameters />
    <MathParameters>
        <MathParameter id="MathLoadFromPids" units="g/cyl" zoom="False" />
    </MathParameters>
</LogProfile>
